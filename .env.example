# App
NODE_ENV=development
PORT=8000

# Database (PostgreSQL) — wired when the first DB-backed module is added
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=e-commerce

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP (FR-AUTH-020..024 defaults)
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=60
OTP_HOURLY_CAP=5
OTP_ATTEMPT_CAP=5

# NOTIF dispatch (OTP SMS). Leave URL blank in dev → the code is logged instead of sent.
NOTIF_DISPATCH_URL=
NOTIF_SERVICE_TOKEN=

# SMS OTP gateway (client-provided; consumed by NOTIF)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=

# Payments
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
