# App
NODE_ENV=development
PORT=8000
# CORS allowed origins (comma-separated), e.g. https://shop.example.com,https://admin.example.com
# Leave BLANK in dev — the API then reflects the request origin so any localhost/LAN port is allowed.
# Set the real frontend domains in production.
CORS_ORIGINS=

# Database (PostgreSQL) — wired when the first DB-backed module is added
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=e-commerce

# JWT — REQUIRED. The app fails to boot when JWT_ACCESS_SECRET is blank. Set a strong
# random value (e.g. `openssl rand -base64 48`); rotating it forcibly invalidates every
# issued access token. Never use a shared/committed value in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP (FR-AUTH-020..024 defaults)
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=60
OTP_HOURLY_CAP=5
OTP_ATTEMPT_CAP=5
# DEV-ONLY: echo the OTP back in POST /auth/otp/request so the frontend can show it (no SMS gateway
# in dev). Hard-disabled when NODE_ENV=production regardless of this value. NEVER set true in prod.
OTP_DEV_RETURN=true

# MFA (module 17 — configurable customer 2FA, docs/srs/17-mfa.md).
# Per-challenge TTL / resend cooldown / attempt cap live on the admin-editable `mfa_settings` row
# (seeded email-on / sms-off / optional). These two are env-only runtime tunables:
MFA_RESEND_HOURLY_CAP=5
MFA_PRE_AUTH_TTL=300

# Google sign-in — the OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services →
# Credentials). POST /auth/google verifies the ID token's `aud` against this. The storefront needs
# the SAME value as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in (returns 503).
GOOGLE_CLIENT_ID=

# Email + password login (FR-AUTH-012, 043)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFY_TTL=24h
EMAIL_VERIFY_RESEND_COOLDOWN=60
# Password-reset link lifetime (FR-AUTH-033, default 30 min)
PASSWORD_RESET_TTL=30m
# First-password set (FR-AUTH-036/037): OTP waiver window after an OTP-verified login,
# and the lifetime of the single-use set_token issued inside that window (defaults 10 min).
PASSWORD_SET_FRESHNESS_WINDOW=600
PASSWORD_SET_TOKEN_TTL=600
# Storefront base URL — used to build the email-verification link.
STOREFRONT_URL=http://localhost:3000

# NOTIF dispatch (OTP SMS). Leave URL blank in dev → the code is logged instead of sent.
NOTIF_DISPATCH_URL=
NOTIF_SERVICE_TOKEN=

# NOTIF promotional path (campaigns, opt-in, quiet hours, rate limit, unsubscribe)
NOTIF_PROMO_DAILY_CAP=2
NOTIF_QUIET_HOURS_START=22:00
NOTIF_QUIET_HOURS_END=08:00
NOTIF_PROMO_DEFERRAL_SWEEP_MS=60000
# HMAC secret for tokenized unsubscribe links — set a strong value in production.
NOTIF_UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret
# Stub OptIn seam (until AUTH wiring): comma-separated opted-out + seeded "all opted-in" recipients.
NOTIF_PROMO_OPTOUT_LIST=
NOTIF_PROMO_SEED_RECIPIENTS=

# NOTIF provider webhook secrets (FR-NOTIF-041, §14): HMAC-SHA256 secret the provider signs the raw
# webhook body with (x-webhook-signature header). Blank in dev → signature verification is skipped
# (logged); set in production to reject unverified DLR / email-event callbacks.
NOTIF_SMS_WEBHOOK_SECRET=
NOTIF_EMAIL_WEBHOOK_SECRET=
# NOTIF DLR stale sweep (§12.2): a `sent` message with no DLR older than NOTIF_DLR_STALE_AGE_MS
# (default 6h) is marked `unknown`. NOTIF_DLR_STALE_SWEEP_MS is the check interval (0 disables).
NOTIF_DLR_STALE_AGE_MS=21600000
NOTIF_DLR_STALE_SWEEP_MS=300000

# Service token guarding AUTH internal endpoints (e.g. POST /internal/customers/lightweight,
# called by CART checkout placement). Blank in dev → falls back to "dev-internal-token".
INTERNAL_SERVICE_TOKEN=

# INV reservations — online-order hold duration (default 30 min, SRS §15/§16) + expiry-sweep interval.
INVENTORY_RESERVATION_HOLD_MS=1800000
INVENTORY_RESERVATION_SWEEP_MS=60000

# ORD auto-cancel — unpaid online orders cancel after the timeout (default 30 min, FR-ORD-012),
# with a payment reminder sent the lead time before (default 10 min, FR-ORD-012a). Sweep interval
# drives the periodic check (0 disables; tests run the sweep manually).
ORDER_AUTO_CANCEL_MS=1800000
ORDER_PAYMENT_REMINDER_LEAD_MS=600000
ORDER_AUTO_CANCEL_SWEEP_MS=60000

# PAY gateways — storefront result page the webhooks redirect to (advisory), bKash id-token TTL,
# and reconciliation (finalize lost callbacks/IPN after the grace window; sweep interval, 0 disables).
STOREFRONT_RESULT_URL=http://localhost:3000/checkout/result
BKASH_ID_TOKEN_TTL_MS=3300000
PAYMENT_RECONCILE_GRACE_MS=300000
PAYMENT_RECONCILE_SWEEP_MS=120000
# Min gap between poll-driven (on-demand) gateway re-queries for the same payment, triggered when the
# storefront result page polls an `initiated` online payment whose IPN hasn't landed (FR-PAY-034).
PAYMENT_RECONCILE_ONDEMAND_THROTTLE_MS=5000

# RPT export + scheduled digests (FR-RPT-070/071). Exports (CSV/PDF) are uploaded to Cloudinary as `raw`
# files under REPORTS_EXPORT_FOLDER (nested under CLOUDINARY_ROOT_FOLDER) and served from the returned
# HTTPS URL; the download link expires after REPORTS_EXPORT_TTL_MS. (Local-disk storage was dropped — the
# deployed path was not writable, the same issue that moved media to Cloudinary.) REPORTS_SCHEDULE_SWEEP_MS
# is the cadence-runner interval (0 disables; auto-disabled under NODE_ENV=test).
REPORTS_EXPORT_FOLDER=report-exports
REPORTS_EXPORT_TTL_MS=86400000
REPORTS_SCHEDULE_SWEEP_MS=3600000

# CUST customer-list export (FR-CUST-040). The CSV is uploaded to Cloudinary as a `raw` file under
# CUSTOMERS_EXPORT_FOLDER (nested under CLOUDINARY_ROOT_FOLDER) and served from the returned HTTPS URL;
# the download link expires after CUSTOMERS_EXPORT_TTL_MS. Excludes secrets (non-sensitive fields only).
CUSTOMERS_EXPORT_FOLDER=customer-exports
CUSTOMERS_EXPORT_TTL_MS=86400000

# RBAC — admin auth (FR-RBAC-001..007, 030..034). Admin tokens reuse JWT_ACCESS_SECRET
# with a distinct `admin` audience.
ADMIN_JWT_ACCESS_TTL=6h
ADMIN_JWT_REFRESH_TTL=30d
ADMIN_JWT_REFRESH_TTL_REMEMBER=90d
ADMIN_LOGIN_LOCK_THRESHOLD=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_2FA_OTP_TTL=300
ADMIN_2FA_ATTEMPT_CAP=5
ADMIN_RESET_TOKEN_TTL=1h
# Base URL of the admin panel (used to build password-reset links).
ADMIN_PANEL_URL=http://localhost:3001
# Bootstrap Super Admin (seeded once, idempotently). Change the password before first login.
SUPER_ADMIN_SEED_EMAIL=startsmartztechnologiesbd@gmail.com
SUPER_ADMIN_SEED_PASSWORD=ChangeMe-Admin1
SUPER_ADMIN_SEED_NAME=Super Admin
SUPER_ADMIN_SEED_PHONE=

# CAT — product media storage (FR-CAT-030/031). Uploaded originals are written under
# MEDIA_UPLOAD_DIR and served statically at /media; stored image URLs are prefixed with
# MEDIA_PUBLIC_BASE_URL so <img src> resolves from the admin panel / storefront. Defaults work
# for local dev; point MEDIA_PUBLIC_BASE_URL at the public API origin in production (or a CDN).
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# SMS OTP gateway (client-provided; consumed by NOTIF)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=

# Payments
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Email — transactional mail (admin invite, lead ack/reply, etc.). Blank MAIL_HOST in dev → the
# email is logged to the console instead of sent. MAIL_FROM is the From address (falls back to
# noreply@sportshop.com.bd when unset).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@sportshop.com.bd

# Seller / invoice details (ORD invoice — Mushak 6.3). BIN is a placeholder until the real VAT BIN is provided.
SELLER_NAME=Sports E-Commerce Ltd.
SELLER_ADDRESS=Dhaka, Bangladesh
SELLER_PHONE=+8809600000000
SELLER_BIN=000000000-0000

# Leads & Contact (LEAD) — claim-evidence storage + spam protection
PUBLIC_BASE_URL=http://localhost:8000
LEAD_UPLOAD_DIR=./uploads/lead-attachments
# Spam protection (FR-LEAD-006). When LEAD_CAPTCHA_ENABLED=true the chosen provider verifies the
# token server-side; disabled → bypass (dev). Provider: `turnstile` (Cloudflare) or `stub` (default).
# TURNSTILE_SECRET_KEY is the server secret from the Cloudflare Turnstile dashboard (use Cloudflare's
# test keys in dev). Never commit a real secret.
LEAD_CAPTCHA_ENABLED=false
LEAD_CAPTCHA_PROVIDER=stub
TURNSTILE_SECRET_KEY=

# Dashboard (DASH) — cached-aggregate staleness window in ms (FR-DASH-031, default 5 min)
DASH_CACHE_TTL_MS=300000

# Cloudinary — product/lead/exchange media is uploaded here and served from the returned HTTPS URL.
# Create a (free) account at cloudinary.com → Dashboard shows these values. Required for image uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional root folder all uploads are nested under in the media library (default: ecommerce).
CLOUDINARY_ROOT_FOLDER=ecommerce
